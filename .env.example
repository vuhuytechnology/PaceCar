PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Optional: use an explicit proxy policy when deployed behind a gateway.
# TRUST_PROXY=loopback
# Optional: override the local JSON database location (also used by isolated tests).
# PACECAR_DB_FILE=D:\data\pacecar-db.json
# Optional: store uploaded files outside the source tree (use the same persistent disk as the database).
# PACECAR_UPLOAD_DIR=D:\data\uploads
# Local JSON + disk uploads are suitable for a single-instance demo deployment.
# For horizontal production deployment, replace them with PostgreSQL and object storage.
# Optional feature flag (default off): enables the admin-only commission preview/trial records.
# The trial never charges anyone and never changes renter totals. Keep unset in production until the business confirms the policy.
# COMMISSION_TRIAL_ENABLED=true

# Optional email verification at sign-up (default off). When true, new accounts must enter a 6-digit
# code emailed to them before they can log in. Existing accounts are unaffected.
# Gmail: enable 2-step verification, create an App Password and use it as SMTP_PASS.
# EMAIL_VERIFICATION_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM=PaceCar <your-address@gmail.com>
